<Window x:Class="BanID.Views.CaptchaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BanID - Проверка" Height="300" Width="350"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Введите код с картинки" FontSize="18" 
                   Margin="0,0,0,15" HorizontalAlignment="Center"/>

        <Border Grid.Row="1" Background="LightGray" CornerRadius="5" 
                Height="50" Margin="0,0,0,10">
            <TextBlock x:Name="CaptchaTextBlock" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBox x:Name="CaptchaInput" Grid.Row="2" Margin="0,0,0,15" 
                 Height="30" FontSize="14" HorizontalContentAlignment="Center"/>

        <Button Grid.Row="3" Content="Подтвердить" Height="35" 
                Click="Verify_Click" FontSize="14"/>
    </Grid>
</Window>