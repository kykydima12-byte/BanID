<Window x:Class="BanID.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BanID - Регистрация" Height="450" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Регистрация" FontSize="24" FontWeight="Bold" 
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" Text="Логин:"/>
        <TextBox x:Name="LoginBox" Grid.Row="2" Margin="0,5,0,10" Height="30"/>

        <TextBlock Grid.Row="3" Text="Пароль:"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="4" Margin="0,5,0,10" Height="30"/>

        <TextBlock Grid.Row="5" Text="ФИО:"/>
        <TextBox x:Name="FullNameBox" Grid.Row="6" Margin="0,5,0,10" Height="30"/>

        <TextBlock Grid.Row="7" Text="Телефон:"/>
        <TextBox x:Name="PhoneBox" Grid.Row="8" Margin="0,5,0,10" Height="30"/>

        <Button Grid.Row="9" Content="Зарегистрироваться" Height="40" Click="Register_Click" Margin="0,20"/>
    </Grid>
</Window>